<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime (Developer ID, notarisation): access to the Photos library through PhotoKit
       (Apple Photos in the library). Nothing else: no JIT, no unsigned libraries, no Apple Events. -->
  <key>com.apple.security.personal-information.photos-library</key><true/>
</dict>
</plist>
