# Clean runtime environment for the headless test of the experimental Linux build (only what the package needs,
# see scripts/bundle-linux.sh). Used with docker run -v <target volume>:/target.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends libopenblas0 libxkbcommon0 libxkbcommon-x11-0 libfontconfig1 libx11-6 libxcursor1 libxrandr2 libxi6 libxcb1 libwayland-client0 libwayland-cursor0 libwayland-egl1 libvulkan1 mesa-vulkan-drivers libgl1 libegl1 libdbus-1-3 xvfb xauth && rm -rf /var/lib/apt/lists/*
