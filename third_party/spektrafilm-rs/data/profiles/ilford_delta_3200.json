xt": "Delta 3200 kam 1998, etwa zehn Jahre nach Kodaks T-Max P3200, und ersetzte den Film HPS. Nach ISO gemessen liegt er bei 1000, ist aber auf EI 3200 und verl\u00e4ngerte Entwicklung ausgelegt.", "source": "https://en.wikipedia.org/wiki/Ilford_Delta"}, {"text": "Das Datenblatt empfiehlt EI 3200/36 mit verl\u00e4ngerter Entwicklung; gute Ergebnisse gibt es von EI 400 bis EI 6400, bis EI 25000 nach Tests.", "source": "Ilford Delta 3200 Professional, Technical Information"}]}, "grain_size_classes": {"classes": 4, "area_spread": 2.0, "speed_exponent": 1.0}}, "data": {"wavelengths": [380.0, 385.0, 390.0, 395.0, 400.0, 405.0, 410.0, 415.0, 420.0, 425.0, 430.0, 435.0, 440.0, 445.0, 450.0, 455.0, 460.0, 465.0, 470.0, 475.0, 480.0, 485.0, 490.0, 495.0, 500.0, 505.0, 510.0, 515.0, 520.0, 525.0, 530.0, 535.0, 540.0, 545.0, 550.0, 555.0, 560.0, 565.0, 570.0, 575.0, 580.0, 585.0, 590.0, 595.0, 600.0, 605.0, 610.0, 615.0, 620.0, 625.0, 630.0, 635.0, 640.0, 645.0, 650.0, 655.0, 660.0, 665.0, 670.0, 675.0, 680.0, 685.0, 690.0, 695.0, 700.0, 705.0, 710.0, 715.0, 720.0, 725.0, 730.0, 735.0, 740.0, 745.0, 750.0, 755.0, 760.0, 765.0, 770.0, 775.0, 780.0], "log_sensitivity": [[-1.1966019644510932], [-1.1492155530959518], [-1.1173193303130793], [-1.0944201384893881], [-1.0797013122822172], [-1.0654650179760288], [-1.0527882620625475], [-1.0426390659186344], [-1.0343031809807914], [-1.0279630029497724], [-1.0237870622956362], [-1.0200475360897856], [-1.0175974874779388], [-1.0155537449679524], [-1.0135352794208203], [-1.0134102262537414], [-1.0114948884910848], [-1.0135195750574992], [-1.016040855504704], [-1.0237870622956362], [-1.0321794873509358], [-1.03949377291109], [-1.0450802719969836], [-1.0494671222450973], [-1.0530277519246902], [-1.0538987370441721], [-1.0538987370441721], [-1.051677277050214], [-1.0450802719969836], [-1.03253271590388], [-1.0217589462006542], [-1.0074736145581606], [-0.9973817635986221], [-0.9879074912135675], [-0.9822055123890973], [-0.9779095115911494], [